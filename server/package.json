{
  "name": "san-hon-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:ratelimit": "tsx scripts/ratelimit-test.ts",
    "test:accounts": "tsx scripts/accounts-test.ts",
    "test:presence": "tsx scripts/presence-test.ts",
    "test:presence-kill": "tsx scripts/presence-kill-test.ts",
    "test:equip": "tsx scripts/equip-test.ts",
    "test:radar": "tsx scripts/radar-test.ts",
    "test:gm": "tsx scripts/gm-test.ts",
    "econ:equip": "tsx scripts/equip-econ.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --sourcemap --outfile=dist/index.mjs"
  },
  "dependencies": {
    "@colyseus/redis-driver": "0.16.1",
    "@colyseus/redis-presence": "0.16.4",
    "@colyseus/schema": "3.0.76",
    "@colyseus/ws-transport": "0.16.5",
    "colyseus": "0.16.5",
    "express": "4.22.3",
    "ioredis": "5.11.1",
    "pg": "8.16.3",
    "rung-san-hon-online": "file:.."
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "esbuild": "0.25.12",
    "tsx": "4.19.4",
    "typescript": "5.9.3"
  }
}
