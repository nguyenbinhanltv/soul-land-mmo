{
  "name": "rung-san-hon-online",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "bot:local": "node tools/bot-local.mjs",
    "map": "node tools/gen-map.mjs",
    "map:build": "node tools/maps/build.mjs",
    "map:preview": "node tools/maps/preview.mjs",
    "check": "node tools/check.mjs && node tools/assets/validate.mjs && node tools/assets/lpc-parts.mjs --check && node tools/audio/compose/validate.mjs && node tools/maps/build.mjs --check && node tools/audio/validate-sfx.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "test:audio": "node --test tools/audio/audio.test.mjs tools/audio/sfx.test.mjs",
    "audio:process": "node tools/audio/process.mjs",
    "audio:validate": "node tools/audio/validate.mjs",
    "audio:preview": "node tools/audio/preview.mjs",
    "audio:sfx": "node tools/audio/process-sfx.mjs",
    "audio:preview-sfx": "node tools/audio/preview-sfx.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "ffmpeg-static": "5.3.0"
  }
}
