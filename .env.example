# Sao chép thành server/.env (server tự đọc) hoặc đặt trong phần Environment của dịch vụ hosting.
PORT=2567
# Bỏ trống -> lưu trong RAM (chỉ để thử). Postgres local từ docker-compose:
DATABASE_URL=postgres://sanhon:sanhon@localhost:5432/sanhon
# Supabase: dán chuỗi kết nối Postgres của project (SSL tự bật khi URL chứa "supabase").
# PGSSL=true
# Giới hạn domain được gọi API (mặc định cho phép tất cả):
# CLIENT_ORIGIN=https://game-cua-ban.example
# Chạy sau proxy của nền tảng deploy (Render, Railway, Fly.io…): bật để giới hạn đăng nhập sai theo đúng IP người chơi.
# TRUST_PROXY=1
