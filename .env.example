# ============================================================================
# Mẫu biến môi trường của Sơn Hồn / Soul Land MMO.
#
# Cách dùng:
#   - Chạy local: `cp .env.example server/.env`. server/.env chỉ được đọc khi chạy qua npm script của server
#     (`npm run dev:server` / `start`, cờ --env-file-if-exists); chạy `tsx` / `node` trực tiếp thì phải tự nạp biến.
#     Dòng không có dấu `#` ở đầu là đang bật; bỏ `#` để bật dòng còn lại.
#   - Deploy (prod): KHÔNG dùng file này. Đặt trong ConfigMap / Secret của repo GitOps
#     (docs/ops/gitops.md, docs/ops/trien-khai.md).
#   - Client (Vite) đọc client/.env riêng, xem mục 7.
# Không bao giờ ghi key / token / mật khẩu thật vào file mẫu này. File .env thật đã nằm trong .gitignore.
# Giá trị bên dưới chỉ là mẫu, trống hoặc dạng giả (changeme).
# ============================================================================


# ---------------------------------------------------------------------------
# 1. Server
# ---------------------------------------------------------------------------
# Cổng HTTP + WebSocket của server. Tùy chọn, mặc định 2567 (Dockerfile cũng đặt 2567).
PORT=2567

# Domain client được gọi API (header CORS Access-Control-Allow-Origin). Tùy chọn, mặc định `*` (cho mọi domain).
# Prod nên đặt đúng domain của game.
# CLIENT_ORIGIN=https://game-cua-ban.example

# Chạy sau proxy / load balancer (Render, Railway, Fly.io, ingress GKE…): đặt để rate limit đăng nhập sai
# tính theo đúng IP người chơi. Số bước proxy (vd 1) hoặc tên mạng tin cậy của Express. Tùy chọn, mặc định tắt.
# TRUST_PROXY=1

# Lệnh GM trong game (/gm …, xem docs/test-accounts.md): danh sách accounts.id được dùng, cách nhau dấu phẩy.
# Tùy chọn, bỏ trống = tắt hẳn (mặc định). Prod nên để trống trừ khi thật cần.
# ADMIN_ACCOUNTS=

# Chỉ khi chạy nhiều tiến trình (có REDIS_URL): địa chỉ client dùng để mở WebSocket tới ĐÚNG tiến trình này,
# mỗi tiến trình một địa chỉ (vd game.example.com/2567). Tùy chọn; một tiến trình thì bỏ trống. Nhiều tiến trình mà thiếu
# thì phòng mở ở tiến trình khác không vào được.
# PUBLIC_ADDRESS=localhost:2567

# Đo hiệu năng: đặt (vd 1) để server ghi log thời gian tick / bản vá mỗi 10 giây (docs/tech/hieu-nang-soak). Tùy chọn, mặc định tắt.
# PERF_LOG=1

# Đường lùi bản đồ: danh sách mapId (cách nhau dấu phẩy) hoặc `all` để dùng bản đồ cũ shared/assets/<mapId>.json
# thay bản dựng bằng tools/maps. Tùy chọn, mặc định bỏ trống (dùng bản mới). Dùng để đối chứng hiệu năng.
# MAP_V1=


# ---------------------------------------------------------------------------
# 2. Cơ sở dữ liệu PostgreSQL
# ---------------------------------------------------------------------------
# Chuỗi kết nối PostgreSQL. Tùy chọn: bỏ trống / xóa dòng này = lưu trong RAM (chỉ để thử, tắt server là mất).
# Mẫu dưới là Postgres local của docker-compose.yml (`docker compose up -d`, cổng 5432).
# Supabase (SSL tự bật khi URL chứa "supabase") là DB THỬ NGHIỆM; prod KHÔNG BAO GIỜ trỏ vào Supabase này.
# Không dán chuỗi kết nối thật vào file mẫu / PR / log; chỉ ghi vào server/.env của máy mình.
DATABASE_URL=postgres://sanhon:sanhon@localhost:5432/sanhon

# Ép bật / tắt SSL tới PostgreSQL: `true` hoặc `false`. Tùy chọn, mặc định tự bật khi URL chứa "supabase" hoặc "sslmode=require".
# PGSSL=true

# Số kết nối tối đa của pool. Tùy chọn, mặc định 10.
# PG_POOL_MAX=10

# Giới hạn thời gian mỗi câu lệnh SQL (mili giây). Tùy chọn, mặc định 0 = không giới hạn.
# PG_STATEMENT_TIMEOUT_MS=0

# Thời gian tối đa chờ khoá migration khi nhiều tiến trình khởi động cùng lúc (mili giây). Tùy chọn, mặc định 120000, tối thiểu 1000.
# MIGRATION_LOCK_WAIT_MS=120000


# ---------------------------------------------------------------------------
# 3. Redis (chỉ khi chạy nhiều tiến trình / nhiều kênh)
# ---------------------------------------------------------------------------
# Không đặt REDIS_URL = một tiến trình dùng LocalPresence trong RAM. Nhiều tiến trình phải dùng chung Redis RIÊNG của cụm.
# REDIS_URL=redis://127.0.0.1:6379
# Tiền tố khóa trong Redis (tách nhiều cụm dùng chung một Redis). Tùy chọn, mặc định soul-land-mmo:presence.
# REDIS_PREFIX=soul-land-mmo:presence


# ---------------------------------------------------------------------------
# 4. Đăng nhập Google (tùy chọn, docs/ops/sso-google.md)
# ---------------------------------------------------------------------------
# Client ID công khai của OAuth client loại Web (dạng …apps.googleusercontent.com). Thiếu thì ẩn nút Google.
# GOOGLE_CLIENT_ID=
# Khóa ký vé chọn tên sau khi đăng nhập Google. BÍ MẬT: phải là chuỗi ngẫu nhiên dài (không dùng giá trị đoán được
# như changeme), đặt qua Secret, không commit.
# Chạy nhiều tiến trình thì bắt buộc dùng chung một giá trị; thiếu thì mỗi lần khởi động tự sinh khóa ngẫu nhiên
# (vé cũ hỏng khi khởi động lại, người chơi bấm Google lại là xong).
# GOOGLE_TICKET_SECRET=


# ---------------------------------------------------------------------------
# 5. Bot / chế độ thử (CHỈ máy dev và CI)
# ---------------------------------------------------------------------------
# GAME_TEST=1 bật hook test, nới rate limit, đồng hồ boss riêng, trình xác minh Google giả…
# TUYỆT ĐỐI KHÔNG BẬT Ở PROD: không đặt biến này trong Dockerfile, ConfigMap, Secret hay môi trường prod. Bot ở máy dùng
# `npm run bot:local` (docs/ops/chay-local.md), tự đặt GAME_TEST=1 cho server của nó nên thường không cần ghi ở đây.
# GAME_TEST=1

# Chỉ có tác dụng khi GAME_TEST=1:
#   Số người tối đa mỗi kênh (hạ xuống để thử nhiều kênh). Mặc định lấy CHANNEL_MAX trong shared/data.ts.
# CHANNEL_MAX=2
#   Đồng hồ lịch boss: `HH:MM` = lịch chạy tiếp từ giờ Việt Nam đó lúc bật server (vd 19:54 để thử khung thật);
#   `real` = giờ thật; bỏ trống hoặc sai = đứng yên ở 12:00 (mặc định).
# BOSS_CLOCK=12:00
#   Tỉ lệ (0..1) trả 504 ngẫu nhiên cho request ảnh / json / âm thanh, để thử client tải lại (chỉ khi server phục vụ
#   client/dist; docs/ops/cache-cloudflare.md). Mặc định 0.
# ASSET_FAIL_RATE=0

# Địa chỉ server cho script bot / đo (client/scripts/*). Tùy chọn, mặc định http://localhost:2567.
# SERVER_URL=http://localhost:2567

# Chỉ dùng cho các bài thử cần PostgreSQL riêng (TEST_DATABASE_URL: accounts-test, seed-test, google-test).
# Phải trỏ DB thử, không bao giờ trỏ prod. Để trống thì bài thử tự bỏ qua.
# TEST_DATABASE_URL=

# Bot ở máy (tools/bot-local.mjs, docs/ops/chay-local.md); mọi biến đều tùy chọn:
#   BOT_LOCAL_MAX    số lượt bot song song tối đa (mặc định 2)
#   BOT_HEAP_MB      trần heap Node của server bot, MB (mặc định 768)
#   BOT_PG_PORT      cổng PostgreSQL tạm của bot (mặc định 5433)
#   BOT_PG_URL       dùng PostgreSQL có sẵn thay vì tự bật (bạn tự quản)
#   BOT_PG_DIR       thư mục dữ liệu PostgreSQL dùng chung
#   BOT_REDIS_BIN    đường dẫn redis-server (mặc định `redis-server` trong PATH)
# BOT_LOCAL_MAX=2
# BOT_HEAP_MB=768
# BOT_PG_PORT=5433


# ---------------------------------------------------------------------------
# 6. Công cụ ảnh / âm thanh (tools/, chỉ máy người làm asset; tùy chọn)
# ---------------------------------------------------------------------------
# File chứa API key PixelLab (key nằm ở FILE ngoài repo, không ghi key vào đây). Mặc định ~/.config/pixellab/api-key.txt.
# PIXELLAB_KEY_FILE=
# Thư mục hộp thư ảnh để `tools/assets/inbox.mjs` nhập (hoặc truyền --dir).
# ANH_INBOX=
# Thư mục ảnh LPC (tools/assets/lpc-compose.mjs, lpc-parts.mjs, lpc-beast.mjs: LPC_DIR / LPC_BEAST_DIR).
# LPC_DIR=
# Đường dẫn trình duyệt Chrome (mặc định là đường dẫn Windows cố định, máy khác phải đặt): CHROME cho
# tools/assets/to-png.mjs, ui-border-image-probe.mjs, client/scripts/ui-shots.mjs; CHROME_BIN cho
# client/scripts/fx-measure.mjs, load-measure.mjs; CHROME_PATH cho tools/audio/measure-sfx.mjs.
# CHROME=
# CHROME_BIN=
# CHROME_PATH=
# Đường dẫn ffmpeg để xử lý âm thanh. Mặc định dùng ffmpeg-static.
# FFMPEG=
# Thư mục tài nguyên riêng (không commit) cho tools/maps/preview.mjs. Mặc định shared/assets/private.
# PRIVATE_DIR=


# ---------------------------------------------------------------------------
# 7. Client Vite (đặt trong client/.env, KHÔNG phải server/.env; biến VITE_* bị nhúng công khai vào bản build)
# ---------------------------------------------------------------------------
# Địa chỉ server cho client. Tùy chọn. Mặc định: cổng 5173 (dev) gọi localhost:2567; còn lại dùng cùng origin
# với trang (deploy chung một link). Chỉ đặt khi client và server khác địa chỉ. Không đặt bí mật vào biến VITE_*.
# VITE_SERVER_URL=http://localhost:2567


# ---------------------------------------------------------------------------
# Không liệt kê ở đây (lý do)
# ---------------------------------------------------------------------------
# - Secret / biến CI và deploy (GITHUB_TOKEN, GCP_SA_KEY, GCP_WIF_PROVIDER, GITOPS_TOKEN, ASSETS_DEPLOY_KEY…):
#   chỉ dùng trong .github/workflows, đặt ở GitHub Secrets / Variables (docs/ops/ci.md, gitops.md), không hợp với file chạy local.
# - Biến tiêu chuẩn / do hệ thống đặt (NODE_ENV, CI, TEMP, GITHUB_REPOSITORY, GITHUB_STEP_SUMMARY, SOURCE_DATE_EPOCH, AO_SESSION_ID…).
# - Núm chỉnh riêng từng script thử / chụp ảnh (AB_*, C8_*, C16_*, BANDO_*, FLOW_*, PANEL_*, FATAL_*, BOT_PART/BOT_ONLY…):
#   đọc đầu file script tương ứng trong client/scripts/ và tools/; thường do `npm run bot:local` tự truyền.
